# Infrastructure Intelligence Service (Augur)
APP_APP_NAME=infrastructure-intelligence-service
APP_SERVER_PORT=8089
APP_GRPC_PORT=50059
APP_DATABASE_NAME=augur_service
APP_REDIS_DB=8
APP_KAFKA_CLIENT_ID=augur-service-1
APP_KAFKA_GROUP_ID=augur-service

# Agent identity subsystem (P3+, D-177). ON: augur builds the Vault-PKI client at
# boot (SVID->Vault), issues its hub server cert, and serves the mTLS agent-plane
# listener on APP_AGENT_PLANE_PORT; FAILS BOOT if the PKI client can't build
# (fail-closed). The Vault SVID env lives in the compose augur-service block.
APP_AGENT_PLANE_ENABLED=true
